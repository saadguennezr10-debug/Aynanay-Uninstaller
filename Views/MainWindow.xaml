<Window x:Class="AynanayUninstaller.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aynanay Uninstaller"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource WhiteBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <StackPanel Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="10">
            <TextBlock Text="MENU" FontWeight="Bold" FontSize="14" Margin="0,0,0,20" Foreground="{StaticResource SecondaryTextBrush}" />

            <Button Content="Programs" 
                    Margin="0,5" 
                    Padding="10,8"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="Programs"
                    Background="{StaticResource PrimaryRedBrush}" />

            <Button Content="Installation Monitor" 
                    Margin="0,5" 
                    Padding="10,8"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="Monitor"
                    Background="{StaticResource CardBrush}" />

            <Button Content="Startup Manager" 
                    Margin="0,5" 
                    Padding="10,8"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="Startup"
                    Background="{StaticResource CardBrush}" />

            <Button Content="Junk Cleaner" 
                    Margin="0,5" 
                    Padding="10,8"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="Junk"
                    Background="{StaticResource CardBrush}" />

            <Separator Background="{StaticResource SecondaryCardColor}" Margin="0,20,0,10" Height="1" />

            <Button Content="Settings" 
                    Margin="0,5" 
                    Padding="10,8"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="Settings"
                    Background="{StaticResource CardBrush}" />

            <Button Content="About" 
                    Margin="0,5" 
                    Padding="10,8"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="About"
                    Background="{StaticResource CardBrush}" />
        </StackPanel>

        <!-- Main Content Area -->
        <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden" />

    </Grid>
</Window>