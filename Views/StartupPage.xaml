<Page x:Class="AynanayUninstaller.Views.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Startup Manager"
      Background="{StaticResource BackgroundBrush}"
      Foreground="{StaticResource WhiteBrush}">
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Startup Manager" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" />

        <!-- Startup Entries DataGrid -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding StartupEntries}"
                  Background="{StaticResource CardBrush}"
                  RowBackground="{StaticResource CardBrush}"
                  AlternatingRowBackground="{StaticResource SecondaryCardColor}"
                  Foreground="{StaticResource WhiteBrush}"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AutoGenerateColumns="False"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="80" />
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="250" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" />
                <DataGridTextColumn Header="Path" Binding="{Binding ExecutablePath}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Enable" Padding="15,10" Margin="0,0,10,0" Background="{StaticResource SuccessBrush}" />
            <Button Content="Disable" Padding="15,10" Margin="0,0,10,0" Background="{StaticResource WarningBrush}" />
            <Button Content="Delete" Padding="15,10" Background="{StaticResource DangerRedBrush}" />
        </StackPanel>
    </Grid>
</Page>